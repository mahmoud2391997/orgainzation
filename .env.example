# PostgreSQL connection string.
# Local server (no TLS): postgresql://USER:PASSWORD@127.0.0.1:5432/antitude?sslmode=disable
# Managed hosts (including Hostinger) usually require TLS: append ?sslmode=require
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/antitude?sslmode=disable

# Set a strong secret in every non-local environment.
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional connection pool size (keep this small on shared hosting).
DATABASE_POOL_MAX=5

# Optional: if you cannot (or do not want to) add `?sslmode=require` to DATABASE_URL,
# you can configure SSL via DATABASE_SSLMODE instead.
# Supported values: disable | prefer | require | no-verify
# DATABASE_SSLMODE=require

# Optional: in production the app will *not* fall back to local JSON storage by default.
# Set this to true only if you intentionally want fallback behavior.
# ALLOW_JSON_FALLBACK=true
